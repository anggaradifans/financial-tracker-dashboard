{
  "name": "supabase-registration",
  "version": "1.0.0",
  "type": "module",
  "description": "Simple user registration page with Supabase",
  "main": "index.html",
  "scripts": {
    "test:security": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:database": "bash database/tests/run.sh",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sentry/react": "^10.75.0",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.552.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-actions": "^7.0.27",
    "@storybook/addon-controls": "^7.0.27",
    "@storybook/addon-essentials": "^7.0.27",
    "@storybook/addon-interactions": "^7.0.27",
    "@storybook/addon-links": "^7.0.27",
    "@storybook/addon-viewport": "^7.0.27",
    "@storybook/blocks": "^7.0.27",
    "@storybook/react": "^7.0.27",
    "@storybook/react-vite": "^7.0.27",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.32",
    "storybook": "^7.0.27",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.8"
  }
