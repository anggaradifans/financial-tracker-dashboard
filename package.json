{
  "name": "supabase-registration",
  "version": "1.0.0",
  "type": "module",
  "description": "Simple user registration page with Supabase",
  "main": "index.html",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test:security": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:database": "bash database/tests/run.sh",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "lint": "eslint .",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sentry/react": "^10.75.0",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.552.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.7",
    "storybook": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6"
  },
  "overrides": {
    "@storybook/react-vite": {
      "@joshwooding/vite-plugin-react-docgen-typescript": "^0.9.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
