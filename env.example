# Supabase Configuration
# Replace these with your actual Supabase project values
VITE_SUPABASE_URL=your_supabase_project_url

# The legacy variable name is retained for app compatibility. Set its value to
# the new Supabase publishable key. RLS enforces user access.
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Optional. Monitoring stays disabled when this is blank.
VITE_SENTRY_DSN=
