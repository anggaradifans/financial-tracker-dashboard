# Server-only: read by api/parse-statement.ts. Never add a VITE_ prefix, or
# Vite will embed it in the public bundle. Run `vercel dev` to serve /api locally.
GEMINI_API_KEY=<gemini_key>
VITE_SUPABASE_URL=<supabase_url>
VITE_SUPABASE_ANON_KEY=<supabase_publishable_key>
VITE_SENTRY_DSN=<optional_sentry_dsn>
